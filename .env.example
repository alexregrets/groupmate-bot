# Токен вашего бота от BotFather, обязательный
TELEGRAM_BOT_TOKEN=replace_with_botfather_token
# Числовой ID вашей группы; -200 здесь выдуманный пример, замените
TELEGRAM_GROUP_CHAT_ID=-200
# Ваш числовой Telegram user ID для /cost в личке и предупреждений, пусто выключает
ADMIN_CHAT_ID=
# Часовой пояс IANA для расписания, дедлайнов и дневного бюджета
TIMEZONE=Europe/Moscow
# Каталог SQLite, в контейнере оставьте state
STATE_DIR=state
# Номер топика для пингов, пусто означает общий чат
PING_THREAD_ID=
# Номер топика для почты, пусто использует PING_THREAD_ID
MAIL_THREAD_ID=
# IMAP-сервер с TLS; почта выключена, пока IMAP_USER пуст
IMAP_HOST=imap.example.test
# Адрес общего ящика; пусто выключает основной ящик
IMAP_USER=
# Пароль приложения основного ящика
IMAP_PASSWORD=
# Почтовая папка основного ящика
IMAP_FOLDER=INBOX
# Дополнительные ящики: JSON-массив, формат в README; секреты тоже внутри .env
MAIL_SOURCES=[]
# Интервал проверки ящиков в секундах, не меньше 1
POLL_INTERVAL_SECONDS=60
# 0: первый запуск запоминает текущую границу без рассылки старой почты; 1: переслать историю
FORWARD_HISTORY=0
# Разрешённые фрагменты адресов отправителей через запятую, пусто означает всех
TEACHER_SENDER_FILTER=
# Запрещённые фрагменты адресов отправителей через запятую
SENDER_BLOCKLIST=
# Провайдер расписания: json или ruz
SCHEDULE_PROVIDER=json
# JSON-файл с датами и парами, формат в README
SCHEDULE_FILE=schedule.json
# ID группы в API адаптера ruz; пример выдуманный, нужен только при SCHEDULE_PROVIDER=ruz
RUZ_GROUP_ID=12345
# Интервал обновления кеша ruz в минутах
RUZ_REFRESH_MINUTES=180
# Утренний пинг HH:MM по TIMEZONE; пусто выключает пинг, радар тогда работает с 08:00
MORNING_PING=07:30
# Вечерний пинг HH:MM на следующий день; пусто выключает
EVENING_PING=20:00
# Извлекать задания из писем: 1 или 0
HW_FROM_MAIL=1
# Извлекать задания из сообщений чата: 1 или 0, по умолчанию выключено
HW_FROM_CHAT=0
# Одна строка на задание утром в день сдачи с кнопкой сдал: 1 или 0
RADAR=1
# Отвечать ИИ только на упоминание или reply боту: 1 или 0, по умолчанию выключено
AI_REPLIES=0
# Полный URL OpenAI-совместимого endpoint, заканчивающийся /chat/completions; пусто выключает ИИ
AI_API_URL=
# Секретный ключ LLM, пусто выключает ИИ
AI_API_KEY=
# Название модели у вашего провайдера, пусто выключает ИИ
AI_MODEL=
# Дневной бюджет в USD по TIMEZONE; 0 запрещает все LLM-запросы
AI_DAILY_LIMIT_USD=0.5
# Предупредить администратора при остатке дневного бюджета или ключа не выше этой суммы USD
COST_ALERT_USD=0.1
# Цена миллиона входных токенов USD, если endpoint не возвращает usage.cost
AI_INPUT_USD_PER_MILLION=0
# Цена миллиона выходных токенов USD, если endpoint не возвращает usage.cost
AI_OUTPUT_USD_PER_MILLION=0
